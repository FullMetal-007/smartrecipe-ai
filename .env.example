# Copy to .env and insert your own Gemini API key. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
AI_TEMPERATURE=0.2
AI_CACHE_ENABLED=true
RANKING_PROMPT_VERSION=v1
PROMPT_VERSION=v1
CONFIG_VERSION=1.1.0
NUM_RETRIEVAL_CANDIDATES=100
MAX_RETRIEVAL_CANDIDATES=5000
MAX_CORRECTION_ATTEMPTS=1
